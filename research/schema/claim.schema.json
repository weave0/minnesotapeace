{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minnesotapeace.com/research/schema/claim.schema.json",
  "title": "Minnesota Fraud Research Claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim_text",
    "evidence_class",
    "status",
    "source_ids",
    "confidence",
    "is_allegation",
    "is_inference",
    "reviewed_at"
  ],
  "properties": {
    "claim_id": {"type": "string"},
    "claim_text": {"type": "string", "minLength": 1},
    "subject_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_class": {
      "enum": [
        "ADJUDICATED",
        "CHARGED_ALLEGED",
        "CIVIL_ALLEGED_OR_RESOLVED",
        "AUDIT_FINDING",
        "AGENCY_POSITION",
        "SWORN_TESTIMONY",
        "LEGISLATIVE_FINDING_OR_ALLEGATION",
        "SECONDARY_VERIFIED",
        "LEAD_UNVERIFIED",
        "DERIVED_INFERENCE"
      ]
    },
    "status": {
      "enum": [
        "confirmed",
        "adjudicated",
        "charged",
        "alleged",
        "disputed",
        "superseded",
        "withdrawn",
        "unresolved"
      ]
    },
    "event_date": {"type": ["string", "null"], "format": "date"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_locator": {"type": ["string", "null"]},
    "jurisdiction": {"type": ["string", "null"]},
    "case_number": {"type": ["string", "null"]},
    "program_ids": {"type": "array", "items": {"type": "string"}},
    "amounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "currency", "metric_type"],
        "properties": {
          "value": {"type": "number"},
          "currency": {"type": "string", "default": "USD"},
          "metric_type": {
            "enum": [
              "program_spend",
              "amount_billed",
              "amount_paid",
              "alleged_loss",
              "intended_loss",
              "proven_loss",
              "restitution_ordered",
              "forfeiture_ordered",
              "recovered_amount",
              "identified_for_recovery",
              "civil_settlement",
              "improper_payment_estimate",
              "error_rate",
              "fraud_estimate",
              "unknown_or_disputed"
            ]
          },
          "period_start": {"type": ["string", "null"], "format": "date"},
          "period_end": {"type": ["string", "null"], "format": "date"},
          "methodology": {"type": ["string", "null"]}
        }
      }
    },
    "corroborating_source_ids": {"type": "array", "items": {"type": "string"}},
    "contradicting_claim_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "is_allegation": {"type": "boolean"},
    "is_inference": {"type": "boolean"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
