{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minnesotapeace.com/research/schema/tracker-recovery.schema.json",
  "title": "Minnesota Peace tracker recovery selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "program_id",
        "subject",
        "amount",
        "currency",
        "metric_type",
        "event_date",
        "evidence_class",
        "source_ids",
        "interpretation"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "const": "USD"
        },
        "metric_type": {
          "enum": [
            "restitution_ordered",
            "forfeiture_ordered",
            "forfeiture_sought",
            "assets_seized",
            "assets_recovered",
            "recovered_amount",
            "identified_for_recovery",
            "administrative_recoupment",
            "cost_avoidance"
          ]
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlap_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "collection_status": {
          "type": "string"
        },
        "realization_status": {
          "type": "string"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
