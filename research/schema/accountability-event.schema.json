{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minnesotapeace.com/research/schema/accountability-event.schema.json",
  "title": "Minnesota Peace accountability event document",
  "description": "Append-only events that can drive What Changed projections without rewriting the underlying charging or program record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "program_id",
        "event_type",
        "occurred_at",
        "source_ids",
        "summary"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "CHARGED",
            "PLEADED",
            "CONVICTED",
            "SENTENCED",
            "CASE_APPEARANCE",
            "RESTITUTION_ORDERED",
            "FORFEITURE_ORDERED",
            "RECOVERY_REPORTED",
            "PROGRAM_CONTROL_ANNOUNCED",
            "PROGRAM_CONTROL_IMPLEMENTED",
            "PROGRAM_TERMINATED",
            "REFORM_DEADLINE",
            "MEASUREMENT_PUBLISHED"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "legal_stage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CHARGED",
            "PLEADED",
            "CONVICTED",
            "SENTENCED",
            null
          ]
        },
        "implementation_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ANNOUNCED",
            "ENACTED",
            "IMPLEMENTED",
            "MEASURED",
            "EFFECTIVE",
            null
          ]
        },
        "effectiveness": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "UNKNOWN",
            "DEMONSTRATED",
            "NOT_DEMONSTRATED",
            null
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "unit"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "money_category": {
          "type": "string",
          "enum": [
            "program_spend",
            "amount_billed",
            "amount_claimed",
            "amount_paid",
            "alleged_loss",
            "proven_loss",
            "restitution_ordered",
            "forfeiture_ordered",
            "recovered_amount",
            "identified_for_recovery",
            "cost_avoidance",
            "fraud_estimate"
          ]
        },
        "metric_category": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "USD"
              }
            }
          },
          "then": {
            "required": [
              "money_category"
            ]
          }
        }
      ]
    }
  }
}
